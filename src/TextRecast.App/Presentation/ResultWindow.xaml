<Window x:Class="TextRecast.App.Presentation.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TextRecast"
        Icon="/TextRecast;component/Assets/Brand/textrecast-icon.png"
        Width="430"
        Height="336"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Keep the expensive shadow on a static visual so busy animations do not
             invalidate the entire shadowed content tree on every frame. -->
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="10"
                Effect="{StaticResource PanelShadow}"
                IsHitTestVisible="False" />
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="122" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Image Width="22"
                           Height="22"
                           Source="/TextRecast;component/Assets/Brand/textrecast-mark.png"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1"
                               Text="TextRecast"
                               Foreground="White"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Width="28"
                            Height="28"
                            Style="{StaticResource HeaderButton}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close formatter"
                            Click="Close_Click">
                        <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,18,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewLabel"
                           Text="Selected text"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="10.5"
                           FontWeight="SemiBold" />
                <TextBox x:Name="ResultTextBox"
                         Grid.Row="1"
                         Height="69"
                         VerticalAlignment="Top"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="{StaticResource DividerBrush}"
                         BorderThickness="1"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource InkBrush}"
                         FontSize="12.5"
                         Padding="10,8" />
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <TextBlock Text="Format as"
                           Margin="2,0"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="10.5"
                           FontWeight="SemiBold" />
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                <UniformGrid x:Name="OperationChoices" Columns="5">
                    <RadioButton Tag="Improve" GroupName="Operations" Style="{StaticResource SegmentChoiceButton}" AutomationProperties.Name="Improve writing" Checked="Operation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Sparkles" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Improve" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Shorten" GroupName="Operations" Style="{StaticResource SegmentChoiceButton}" AutomationProperties.Name="Make shorter" Checked="Operation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListMinus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Shorter" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Lengthen" GroupName="Operations" Style="{StaticResource SegmentChoiceButton}" AutomationProperties.Name="Make longer" Checked="Operation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListPlus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Longer" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Summarize" GroupName="Operations" Style="{StaticResource SegmentChoiceButton}" AutomationProperties.Name="Summarize" Checked="Operation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListCollapse" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Summarize" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="ChangeTone" GroupName="Operations" Style="{StaticResource SegmentChoiceButton}" AutomationProperties.Name="Change tone" Checked="Operation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="SlidersHorizontal" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Tone" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                </Border>
            </Grid>

            <Border x:Name="TonePanel"
                    Grid.Row="3"
                    Height="26"
                    Margin="16,4,18,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <UniformGrid x:Name="ToneChoices" Columns="5">
                    <RadioButton Tag="Professional"
                                 GroupName="Tones"
                                 AutomationProperties.Name="Professional tone"
                                 Content="Professional"
                                 Style="{StaticResource ToneChoiceButton}" />
                    <RadioButton Tag="Casual"
                                 GroupName="Tones"
                                 AutomationProperties.Name="Casual tone"
                                 Content="Casual"
                                 Style="{StaticResource ToneChoiceButton}" />
                    <RadioButton Tag="Friendly"
                                 GroupName="Tones"
                                 AutomationProperties.Name="Friendly tone"
                                 Content="Friendly"
                                 Style="{StaticResource ToneChoiceButton}" />
                    <RadioButton Tag="Formal"
                                 GroupName="Tones"
                                 AutomationProperties.Name="Formal tone"
                                 Content="Formal"
                                 Style="{StaticResource ToneChoiceButton}" />
                    <RadioButton Tag="Direct"
                                 GroupName="Tones"
                                 AutomationProperties.Name="Direct tone"
                                 Content="Direct"
                                 Style="{StaticResource ToneChoiceButton}" />
                </UniformGrid>
            </Border>

            <Border Grid.Row="5"
                    Background="{StaticResource FooterBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9">
            <Grid Margin="14,13,20,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <iconPacks:PackIconLucide x:Name="StatusIcon"
                                                  Kind="Circle"
                                                  Width="12"
                                                  Height="12"
                                                  Margin="2,0,8,0"
                                                  Foreground="{StaticResource SecondaryTextBrush}"
                                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid x:Name="ActivityProgressBar"
                          Grid.Row="1"
                          Margin="4,0,11,0"
                          Background="{StaticResource DividerBrush}"
                          ClipToBounds="True"
                          Visibility="Collapsed">
                        <Border Width="124"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BusyIndicatorTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        AutomationProperties.Name="Cancel formatting"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="X" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Text="Cancel" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyButton"
                        Grid.Column="3"
                        AutomationProperties.Name="Apply"
                        Style="{StaticResource PrimaryButton}"
                        Click="Apply_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide x:Name="ApplyButtonIcon"
                                                  Kind="Check"
                                                  Width="12"
                                                  Height="12"
                                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="ApplyButtonText" Text="Apply" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
