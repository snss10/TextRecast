<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CanvasBrush" Color="#F6F6F6" />
  <SolidColorBrush x:Key="InkBrush" Color="#171717" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#202225" />
  <SolidColorBrush x:Key="HeaderHoverBrush" Color="#35383D" />
  <SolidColorBrush x:Key="FooterBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#005A9E" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="DividerBrush" Color="#C9C9C9" />
  <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#F4F4F4" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#8A8A8A" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
  <SolidColorBrush x:Key="AccentOutlineBrush" Color="#60A5D8" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F1FB" />
  <SolidColorBrush x:Key="ReplacingBrush" Color="#0E7490" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
  <SolidColorBrush x:Key="MenuHoverBrush" Color="#E8E8E8" />
  <SolidColorBrush x:Key="MenuIconBrush" Color="#34373B" />
  <SolidColorBrush x:Key="LauncherBorderBrush" Color="#5E636B" />

  <DropShadowEffect x:Key="PanelShadow"
                    BlurRadius="18"
                    ShadowDepth="4"
                    Opacity="0.2"
                    RenderingBias="Performance"
                    Color="#111318" />
  <DropShadowEffect x:Key="LauncherShadow"
                    BlurRadius="12"
                    ShadowDepth="2"
                    Opacity="0.25"
                    RenderingBias="Performance"
                    Color="#111318" />

  <Style x:Key="LauncherContextMenuStyle" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="MinWidth" Value="204" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  Effect="{StaticResource PanelShadow}">
            <StackPanel IsItemsHost="True"
                        KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LauncherMenuItemStyle" TargetType="MenuItem">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="7,0,9,0" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="ItemBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1"
                                ContentSource="Header"
                                Margin="2,0,0,0"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder"
                      Property="Background"
                      Value="{DynamicResource MenuHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DialogButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="25" />
    <Setter Property="MinWidth" Value="82" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style x:Key="InformationTabStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="HeaderButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="HeaderButtonSurface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HeaderButtonSurface"
                      Property="Background"
                      Value="{DynamicResource HeaderHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
    <Setter Property="MinWidth" Value="68" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
    <Setter Property="MinWidth" Value="68" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="SegmentChoiceButton" TargetType="RadioButton">
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="ChoiceBorder"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="0,0,1,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource CanvasBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToneChoiceButton"
         TargetType="RadioButton"
         BasedOn="{StaticResource SegmentChoiceButton}">
    <Setter Property="Height" Value="24" />
    <Setter Property="FontSize" Value="9.5" />
  </Style>
</ResourceDictionary>
