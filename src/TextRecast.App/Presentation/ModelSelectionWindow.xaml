<Window x:Class="TextRecast.App.Presentation.ModelSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a TextRecast model"
        Icon="/Assets/Brand/textrecast-icon.png"
        Width="640"
        Height="680"
        MinWidth="560"
        MinHeight="560"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F6F7F9"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#111318" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085" />
    <SolidColorBrush x:Key="DividerBrush" Color="#C7CDD6" />
    <SolidColorBrush x:Key="FooterBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A4B08" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF6E8" />

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsEnabled" Value="{Binding IsCompatible}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E9EEF8" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.58" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="28,22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Image Width="48"
               Height="48"
               Margin="0,0,16,0"
               Source="/Assets/Brand/textrecast-icon.png"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}"
                     Text="Choose your local model" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Nothing downloads until you confirm one option" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Foreground="#303641"
                 LineHeight="21"
                 TextWrapping="Wrap"
                 Text="Models run privately on this computer. Select one compatible option; you can review its size and known limitations before confirming." />

      <ListBox x:Name="ModelListBox"
               Grid.Row="1"
               Margin="0,18,0,0"
               BorderThickness="0"
               Background="Transparent"
               ItemsSource="{Binding Choices}"
               SelectionChanged="ModelListBox_SelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Available local models">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="16,14"
                    Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
              <StackPanel>
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             FontWeight="SemiBold"
                             Text="{Binding DownloadSizeText}" />
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}"
                             Text="{Binding Profile.DisplayName}" />
                </DockPanel>

                <TextBlock Margin="0,4,0,0"
                           Foreground="#3E4A5A"
                           FontWeight="SemiBold"
                           Text="{Binding BadgeText}" />
                <TextBlock Margin="0,7,0,0"
                           Foreground="#303641"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Text="{Binding Profile.Description}" />

                <Border Margin="0,10,0,0"
                        Padding="10,8"
                        Background="{StaticResource WarningBackgroundBrush}"
                        BorderBrush="#E9C58E"
                        BorderThickness="1"
                        CornerRadius="5">
                  <TextBlock Foreground="{StaticResource WarningBrush}"
                             FontSize="11"
                             LineHeight="17"
                             TextWrapping="Wrap"
                             Text="{Binding Profile.LimitationNotice}" />
                </Border>

                <TextBlock Margin="0,9,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="{Binding CompatibilityText}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="2"
                 Margin="0,8,0,0"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 FontSize="11"
                 LineHeight="17"
                 TextWrapping="Wrap"
                 Text="English-only preview. Local models can make mistakes. Review the replaced text in the source application after every operation." />
    </Grid>

    <Border Grid.Row="2"
            Padding="28,16"
            Background="{StaticResource FooterBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Margin="0,0,10,0"
                Content="Cancel"
                IsCancel="True"
                Style="{StaticResource SecondaryButton}" />
        <Button x:Name="ContinueButton"
                Content="Continue"
                IsDefault="True"
                IsEnabled="False"
                AutomationProperties.Name="Confirm selected model"
                Click="Continue_Click"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
