<Window x:Class="TextRecast.App.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TextRecast"
        Icon="/TextRecast;component/Assets/Brand/TextRecast.ico"
        Width="52"
        Height="52"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Left="48"
        Top="160">
  <Window.ContextMenu>
    <ContextMenu Style="{StaticResource LauncherContextMenuStyle}"
                 Opened="LauncherMenu_Opened">
      <MenuItem Header="Format selected text"
                Style="{StaticResource LauncherMenuItemStyle}"
                Click="FormatSelectedText_Click">
        <MenuItem.Icon>
          <iconPacks:PackIconLucide Kind="Type"
                                    Foreground="{DynamicResource MenuIconBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource MenuSeparatorStyle}" />
      <MenuItem Header="Model information..."
                Style="{StaticResource LauncherMenuItemStyle}"
                Click="ModelInformation_Click">
        <MenuItem.Icon>
          <iconPacks:PackIconLucide Kind="Info"
                                    Foreground="{DynamicResource MenuIconBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Legal &amp; Privacy..."
                Style="{StaticResource LauncherMenuItemStyle}"
                Click="LegalPrivacy_Click">
        <MenuItem.Icon>
          <iconPacks:PackIconLucide Kind="ShieldCheck"
                                    Foreground="{DynamicResource MenuIconBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="About TextRecast"
                Style="{StaticResource LauncherMenuItemStyle}"
                Click="About_Click">
        <MenuItem.Icon>
          <iconPacks:PackIconLucide Kind="CircleQuestionMark"
                                    Foreground="{DynamicResource MenuIconBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource MenuSeparatorStyle}" />
      <MenuItem Header="Exit TextRecast"
                Style="{StaticResource LauncherMenuItemStyle}"
                Click="Quit_Click">
        <MenuItem.Icon>
          <iconPacks:PackIconLucide Kind="LogOut"
                                    Foreground="{DynamicResource MenuIconBrush}" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Window.ContextMenu>

  <Grid x:Name="LauncherSurface"
        Width="52"
        Height="52"
        Focusable="True"
        ToolTip="TextRecast — Format selected text"
        AutomationProperties.Name="TextRecast — Format selected text"
        AutomationProperties.HelpText="Select text in another application, then activate TextRecast to format it."
        MouseLeftButtonDown="LauncherSurface_MouseLeftButtonDown"
        MouseMove="LauncherSurface_MouseMove"
        MouseLeftButtonUp="LauncherSurface_MouseLeftButtonUp"
        KeyDown="LauncherSurface_KeyDown">
    <Border CornerRadius="8"
            Background="#111318"
            Effect="{StaticResource LauncherShadow}">
      <Border BorderBrush="{DynamicResource LauncherBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="4">
        <Image Width="42"
               Height="42"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Source="/TextRecast;component/Assets/Brand/textrecast-icon.png"
               Stretch="Uniform"
               SnapsToDevicePixels="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
    </Border>
  </Grid>
</Window>
