<Window x:Class="TextRecast.App.Presentation.InformationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextRecast"
        Icon="/TextRecast;component/Assets/Brand/TextRecast.ico"
        Width="560"
        Height="440"
        MinWidth="540"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        Topmost="True">
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinAccentScrollBarStyle}" />
  </Window.Resources>
  <Grid Background="{DynamicResource CanvasBrush}"
        SnapsToDevicePixels="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <Border BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="10,6,10,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="54" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Width="36"
               Height="36"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Source="/TextRecast;component/Assets/Brand/textrecast-icon.png"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="HeadingTextBlock"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource InkBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DescriptionTextBlock"
                     Margin="0,2,0,0"
                     FontSize="9"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="PagesTabControl"
                Grid.Row="1"
                Margin="10,8"
                Style="{StaticResource InformationTabControlStyle}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                Foreground="{DynamicResource InkBrush}" />

    <Border x:Name="SinglePagePanel"
            Grid.Row="1"
            Margin="10,8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
      <TextBox x:Name="SinglePageTextBox"
               IsReadOnly="True"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="Transparent"
               Foreground="{DynamicResource InkBrush}"
               BorderThickness="0"
               Padding="10"
               FontFamily="Segoe UI"
               FontSize="10.5" />
    </Border>

    <Border Grid.Row="2"
            Padding="10,8,10,6"
            Background="{DynamicResource FooterBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <Button Width="76"
              HorizontalAlignment="Right"
              IsDefault="True"
              IsCancel="True"
              Content="Close"
              Style="{StaticResource RewriteActionButtonStyle}"
              Click="Close_Click" />
    </Border>
  </Grid>
</Window>
