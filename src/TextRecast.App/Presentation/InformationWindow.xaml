<Window x:Class="TextRecast.App.Presentation.InformationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TextRecast"
        Icon="/TextRecast;component/Assets/Brand/textrecast-icon.png"
        Width="360"
        Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Grid Margin="8">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource PanelShadow}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="*" />
          <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="9,9,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="12,0,8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Border Width="30"
                    Height="30"
                    Background="#111318"
                    BorderBrush="{DynamicResource LauncherBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15">
              <Image Width="26"
                     Height="26"
                     Source="/TextRecast;component/Assets/Brand/textrecast-mark.png"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="7,0,6,0"
                        VerticalAlignment="Center">
              <TextBlock x:Name="HeadingTextBlock"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource InkBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="DescriptionTextBlock"
                         Margin="0,2,0,0"
                         FontSize="10"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2"
                    Width="26"
                    Height="26"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource InkBrush}"
                    Cursor="Hand"
                    ToolTip="Close"
                    AutomationProperties.Name="Close"
                    Click="Close_Click">
              <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
            </Button>
          </Grid>
        </Border>

        <TabControl x:Name="PagesTabControl"
                    Grid.Row="1"
                    Margin="12,10,12,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    Foreground="{DynamicResource InkBrush}" />

        <Border Grid.Row="2"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,9,9">
          <Button Width="76"
                  Margin="0,8,12,8"
                  HorizontalAlignment="Right"
                  IsDefault="True"
                  IsCancel="True"
                  Content="Close"
                  Style="{StaticResource DialogButtonStyle}"
                  Click="Close_Click" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
