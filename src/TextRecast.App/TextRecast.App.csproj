<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TextRecast</AssemblyName>
    <ApplicationIcon>Assets\Brand\TextRecast.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>TextRecast.App</RootNamespace>
    <Product>TextRecast</Product>
    <Title>TextRecast</Title>
    <Description>Local Windows writing assistant for selected text.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <IncludeBundledModels Condition="'$(IncludeBundledModels)' == ''">false</IncludeBundledModels>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextRecast.Core\TextRecast.Core.csproj" />
    <ProjectReference Include="..\TextRecast.Deployment\TextRecast.Deployment.csproj" />
    <ProjectReference Include="..\TextRecast.Infrastructure\TextRecast.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Brand\textrecast-icon.png" />
    <Resource Include="Assets\Brand\textrecast-mark.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Models\*.gguf"
             Condition="'$(IncludeBundledModels)' == 'true'"
             Link="Models\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NSIS-LICENSE.txt"
          Link="NSIS-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="IncludeRuntimeLegalNotices"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_NetCoreRuntimePack Include="@(ResolvedRuntimePack)"
                           Condition="'%(FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_WindowsDesktopRuntimePack Include="@(ResolvedRuntimePack)"
                                  Condition="'%(FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>

    <Error Condition="'@(_NetCoreRuntimePack)' == ''"
           Text="The self-contained .NET runtime pack could not be resolved for legal notice packaging." />
    <Error Condition="'@(_WindowsDesktopRuntimePack)' == ''"
           Text="The self-contained Windows Desktop runtime pack could not be resolved for legal notice packaging." />

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_NetCoreRuntimePack->'%(PackageDirectory)\LICENSE.TXT')"
                             RelativePath="DOTNET-LICENSE.txt"
                             CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_NetCoreRuntimePack->'%(PackageDirectory)\THIRD-PARTY-NOTICES.TXT')"
                             RelativePath="DOTNET-THIRD-PARTY-NOTICES.txt"
                             CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_WindowsDesktopRuntimePack->'%(PackageDirectory)\LICENSE')"
                             RelativePath="WPF-LICENSE.txt"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Error Condition="!Exists('%(_NetCoreRuntimePack.PackageDirectory)\LICENSE.TXT')"
           Text="The .NET runtime pack license file is missing." />
    <Error Condition="!Exists('%(_NetCoreRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES.TXT')"
           Text="The .NET runtime pack third-party notice file is missing." />
    <Error Condition="!Exists('%(_WindowsDesktopRuntimePack.PackageDirectory)\LICENSE')"
           Text="The Windows Desktop runtime pack license file is missing." />
  </Target>
</Project>
