<Window x:Class="TextRecast.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup - TextRecast"
        Width="760"
        Height="500"
        MinWidth="700"
        MinHeight="460"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="58" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="30,24"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="24"
                     FontWeight="SemiBold"
                     Text="TextRecast Setup" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="14"
                     Text="Per-user application installation" />
        </StackPanel>
        <Image Grid.Column="1"
               Width="56"
               Height="56"
               Source="Assets/Brand/textrecast-mark.png"
               Stretch="Uniform"
               AutomationProperties.Name="TextRecast logo" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="30,28">
      <TextBlock x:Name="HeadingTextBlock"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Text="Install TextRecast" />
      <TextBlock x:Name="DescriptionTextBlock"
                 Margin="0,10,0,24"
                 MaxWidth="650"
                 FontSize="14"
                 TextWrapping="Wrap"
                 Text="Install the self-contained Windows application for the current user. No model is included in this package." />
      <TextBlock Margin="0,0,0,6" Text="Installation folder" />
      <TextBox x:Name="InstallDirectoryTextBox"
               Height="32"
               Padding="8,5"
               IsReadOnly="True"
               AutomationProperties.Name="Installation folder" />
      <TextBlock x:Name="StatusTextBlock"
                 Margin="0,24,0,0"
                 FontSize="14"
                 Text="Ready." />
    </StackPanel>

    <Border Grid.Row="2"
            Padding="16,10"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="ActionButton"
                MinWidth="132"
                Height="34"
                Margin="0,0,10,0"
                Click="ActionButton_Click"
                Content="Install"
                IsDefault="True"
                AutomationProperties.Name="Install TextRecast" />
        <Button x:Name="CancelButton"
                MinWidth="112"
                Height="34"
                Click="CancelButton_Click"
                Content="Cancel"
                IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
